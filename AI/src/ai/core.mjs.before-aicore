export class AICore {
  constructor({ provider = "anthropic", model = "claude-sonnet-4-5" } = {}) {
    this.provider = provider;
    this.model = model;
  }

  info() {
    return {
      name: "AI Core",
      version: "1.0.0",
      provider: this.provider,
      model: this.model,
      capabilities: [
        "chat",
        "conversation",
        "memory-ready",
        "tools-ready",
        "provider-routing",
      ],
    };
  }

  async chat(messages) {
    if (!Array.isArray(messages) || messages.length === 0) {
      throw new Error("messages must contain at least one message");
    }

    return {
      provider: this.provider,
      model: this.model,
      messages,
    };
  }
}
