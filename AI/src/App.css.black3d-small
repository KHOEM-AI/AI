:root {
  --bg: #050505;
  --bg-raised: #0b0b0d;
  --panel: #101012;
  --panel-2: #151518;
  --border: #29292d;
  --border-light: #3a3a40;
  --silver: #e7e7ea;
  --silver-dim: #929299;
  --text: #f5f5f7;
  --text-dim: #898991;
  --user-bubble: #19191d;
  --assistant-bubble: #0f0f12;
  --error: #ff7777;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  background:
    radial-gradient(circle at 50% -10%, #242429 0, #0a0a0c 35%, #050505 70%);
  color: var(--text);
  font-family: "Noto Sans Khmer", "Inter", system-ui, sans-serif;
}

button,
textarea {
  font: inherit;
}

.app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  max-width: 820px;
  margin: 0 auto;
  background:
    linear-gradient(145deg, rgba(255,255,255,.025), transparent 30%),
    linear-gradient(180deg, #0b0b0d, #050505);
  box-shadow:
    0 0 80px rgba(0,0,0,.9),
    inset 1px 1px 0 rgba(255,255,255,.035),
    inset -1px -1px 0 rgba(0,0,0,.8);
}

.app__header {
  min-height: 76px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, #151518, #0a0a0c);
  box-shadow:
    0 8px 25px rgba(0,0,0,.55),
    inset 0 1px 0 rgba(255,255,255,.04);
}

.app__brand {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 0;
}

.app__brand-mark {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  font-family: "Inter", sans-serif;
  font-weight: 800;
  font-size: 18px;
  color: #111114;
  background: linear-gradient(145deg, #ffffff, #77777d);
  border: 1px solid #4b4b50;
  border-radius: 12px;
  box-shadow:
    5px 5px 12px rgba(0,0,0,.8),
    -2px -2px 7px rgba(255,255,255,.09),
    inset 1px 1px 2px rgba(255,255,255,.8),
    inset -2px -2px 4px rgba(0,0,0,.45);
}

.app__brand-name {
  min-width: 0;
  font-size: 17px;
  font-weight: 650;
  letter-spacing: .01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2px 8px rgba(0,0,0,.9);
}

.app__clear {
  background: linear-gradient(145deg, #1d1d21, #09090b);
  border: 1px solid var(--border-light);
  color: var(--silver-dim);
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 13px;
  cursor: pointer;
  box-shadow:
    4px 4px 9px rgba(0,0,0,.75),
    inset 1px 1px 2px rgba(255,255,255,.035);
}

.app__clear:hover {
  color: var(--silver);
  border-color: #55555c;
  transform: translateY(-1px);
}

.app__body {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  scrollbar-width: thin;
  scrollbar-color: #343438 transparent;
}

.empty-state {
  margin: auto;
  max-width: 500px;
  padding: 34px;
  text-align: center;
  color: var(--text-dim);
  background:
    linear-gradient(145deg, #17171a, #09090b);
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow:
    14px 14px 30px rgba(0,0,0,.65),
    -4px -4px 15px rgba(255,255,255,.025),
    inset 1px 1px 0 rgba(255,255,255,.04);
}

.empty-state__title {
  font-size: 21px;
  color: var(--text);
  margin: 0 0 9px;
  font-weight: 650;
}

.empty-state__hint {
  font-size: 14px;
  margin: 0;
  line-height: 1.7;
}

.bubble {
  max-width: 78%;
  padding: 12px 16px;
  border-radius: 17px;
  line-height: 1.7;
  font-size: 15px;
  box-shadow:
    7px 8px 18px rgba(0,0,0,.65),
    inset 1px 1px 0 rgba(255,255,255,.025);
}

.bubble--user {
  align-self: flex-end;
  background: linear-gradient(145deg, #242428, #101012);
  border: 1px solid #303035;
  border-bottom-right-radius: 5px;
}

.bubble--assistant {
  align-self: flex-start;
  background: linear-gradient(145deg, #151518, #08080a);
  border: 1px solid #303035;
  border-bottom-left-radius: 5px;
}

.bubble--pending .bubble__text {
  color: var(--text-dim);
}

.error-banner {
  align-self: center;
  color: var(--error);
  font-size: 14px;
  padding: 10px 14px;
  background: #160b0b;
  border: 1px solid #402020;
  border-radius: 10px;
}

.app__composer {
  display: flex;
  gap: 11px;
  padding: 15px 20px 18px;
  border-top: 1px solid var(--border);
  background: linear-gradient(180deg, #111114, #08080a);
  box-shadow:
    0 -12px 30px rgba(0,0,0,.5),
    inset 0 1px 0 rgba(255,255,255,.025);
}

.composer__input {
  flex: 1;
  resize: none;
  min-height: 46px;
  background: linear-gradient(145deg, #18181b, #09090b);
  border: 1px solid #303035;
  border-radius: 14px;
  padding: 12px 14px;
  color: var(--text);
  font-family: inherit;
  font-size: 15px;
  max-height: 140px;
  box-shadow:
    inset 4px 4px 10px rgba(0,0,0,.65),
    inset -1px -1px 3px rgba(255,255,255,.025);
}

.composer__input::placeholder {
  color: #66666d;
}

.composer__input:focus {
  outline: none;
  border-color: #66666d;
  box-shadow:
    inset 4px 4px 10px rgba(0,0,0,.65),
    0 0 0 2px rgba(255,255,255,.035);
}

.composer__send {
  min-width: 78px;
  background: linear-gradient(145deg, #f2f2f4, #77777d);
  color: #101012;
  border: 1px solid #55555b;
  border-radius: 14px;
  padding: 0 18px;
  font-weight: 750;
  font-size: 15px;
  cursor: pointer;
  box-shadow:
    6px 7px 14px rgba(0,0,0,.8),
    -2px -2px 7px rgba(255,255,255,.08),
    inset 1px 1px 2px rgba(255,255,255,.85),
    inset -2px -2px 4px rgba(0,0,0,.35);
  transition: transform .15s ease, filter .15s ease;
}

.composer__send:hover:not(:disabled) {
  transform: translateY(-2px);
  filter: brightness(1.08);
}

.composer__send:active:not(:disabled) {
  transform: translateY(1px);
  box-shadow:
    2px 2px 6px rgba(0,0,0,.8),
    inset 2px 2px 5px rgba(0,0,0,.25);
}

.composer__send:disabled {
  opacity: .35;
  cursor: not-allowed;
}

@media (max-width: 600px) {
  .app__header {
    padding: 12px 14px;
  }

  .app__brand-name {
    font-size: 14px;
  }

  .app__brand-mark {
    width: 38px;
    height: 38px;
  }

  .app__body {
    padding: 16px 13px;
  }

  .bubble {
    max-width: 88%;
  }

  .app__composer {
    padding: 11px 12px 14px;
  }

  .composer__send {
    min-width: 64px;
    padding: 0 12px;
  }
}
