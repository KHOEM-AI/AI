{
  "name": "ai-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:all": "npm run typecheck && npm run build && npm test && (cd ~/KHOEM_AI_repo/localization && npm run verify)",
    "validate:locales": "cd ~/KHOEM_AI_repo/localization && npm run validate:locales",
    "check:duplicates": "cd ~/KHOEM_AI_repo/localization && npm run check:duplicates",
    "report:translations": "cd ~/KHOEM_AI_repo/localization && npm run report:translations",
    "verify": "cd ~/KHOEM_AI_repo/localization && npm run verify"
  },
  "dependencies": {
    "@khoem-ai/localization": "file:../../KHOEM_AI_repo/localization",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
