:root {
  --bg: #14161c;
  --bg-raised: #1b1e26;
  --border: #2a2e38;
  --gold: #c99b4a;
  --gold-soft: #4a3f28;
  --text: #ede7da;
  --text-dim: #9a9fac;
  --user-bubble: #2a2e38;
  --assistant-bubble: #1f2937;
  --error: #d9695f;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: "Noto Sans Khmer", "Inter", system-ui, sans-serif;
}

.app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  max-width: 720px;
  margin: 0 auto;
}

.app__header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.app__brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.app__clear {
  background: none;
  border: 1px solid var(--border);
  color: var(--text-dim);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
}

.app__clear:hover {
  border-color: var(--gold-soft);
  color: var(--text);
}

.app__brand-mark {
  font-family: "Inter", sans-serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.02em;
  color: var(--bg);
  background: var(--gold);
  border-radius: 6px;
  padding: 3px 8px;
}

.app__brand-name {
  font-size: 17px;
  font-weight: 600;
}

.app__body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.empty-state {
  margin: auto;
  text-align: center;
  color: var(--text-dim);
}

.empty-state__title {
  font-size: 18px;
  color: var(--text);
  margin: 0 0 6px;
}

.empty-state__hint {
  font-size: 14px;
  margin: 0;
}

.bubble {
  max-width: 78%;
  padding: 10px 14px;
  border-radius: 14px;
  line-height: 1.6;
  font-size: 15px;
}

.bubble--user {
  align-self: flex-end;
  background: var(--user-bubble);
  border-bottom-right-radius: 4px;
}

.bubble--assistant {
  align-self: flex-start;
  background: var(--assistant-bubble);
  border: 1px solid var(--gold-soft);
  border-bottom-left-radius: 4px;
}

.bubble--pending .bubble__text {
  color: var(--text-dim);
}

.error-banner {
  align-self: center;
  color: var(--error);
  font-size: 14px;
  padding: 8px 12px;
}

.app__composer {
  display: flex;
  gap: 10px;
  padding: 14px 20px;
  border-top: 1px solid var(--border);
  background: var(--bg-raised);
}

.composer__input {
  flex: 1;
  resize: none;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  color: var(--text);
  font-family: inherit;
  font-size: 15px;
  max-height: 140px;
}

.composer__input:focus {
  outline: none;
  border-color: var(--gold);
}

.composer__send {
  background: var(--gold);
  color: #1a1305;
  border: none;
  border-radius: 10px;
  padding: 0 18px;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
}

.composer__send:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
